<UserControl x:Class="MacropadConfigurator.Views.ShortcutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:MacropadConfigurator.Views"
             xmlns:m="clr-namespace:MacropadConfigurator.Models" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=m:Shortcut, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <DropShadowEffect x:Key="DropShadow"
                          BlurRadius="0"
                          ShadowDepth="5"
                          Direction="-45"
                          Color="{DynamicResource MahApps.Colors.ThemeForeground}"
                          Opacity="0.4" />
    </UserControl.Resources>
    
    <Grid Margin="10">
        <!-- Shadow Layer -->
        <Border CornerRadius="5"
                Effect="{StaticResource DropShadow}"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"/>
    
        <!-- Main Content -->
        <Border CornerRadius="5"
                BorderThickness="1"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                Padding="10">
            <StackPanel>
                <TextBlock Text="{Binding Text}" 
                           FontWeight="Bold"
                           Margin="0 0 0 5"/>
                <TextBlock Text="Key: F13" />
                <TextBlock Text="Mods: None" />
                <CheckBox Content="Script"
                          IsHitTestVisible="False"
                          Focusable="False"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0 10 0 -5">
                    <Button Content="{icon:Lucide Kind=Pencil, Width=12, Height=12}"
                            Padding="6 6"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}"/>
                    <Button Content="{icon:Lucide Kind=Play, Width=12, Height=12}"
                            Padding="6 6"
                            Margin="5 0 0 0"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
