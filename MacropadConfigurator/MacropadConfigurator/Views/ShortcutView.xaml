<UserControl x:Class="MacropadConfigurator.Views.ShortcutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:MacropadConfigurator.Views"
             xmlns:m="clr-namespace:MacropadConfigurator.Models" 
             xmlns:v="clr-namespace:MacropadConfigurator.Views" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=m:Shortcut, IsDesignTimeCreatable=False}">
    <Grid Margin="10">
        <!-- Shadow Layer -->
        <Border CornerRadius="5"
                Effect="{StaticResource DropShadow}"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"/>
    
        <!-- Main Content -->
        <Border CornerRadius="5"
                BorderThickness="1"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                Padding="10">
            <StackPanel>
                <TextBlock Text="{Binding Text}" 
                           FontWeight="Bold"
                           Margin="0 0 0 5"/>
                
                <TextBlock Text="{Binding Key, StringFormat=Key: {0}, Converter={StaticResource key_converter}}"/>

                <TextBlock Text="{Binding Modifiers, StringFormat=Mods: {0}, Converter={StaticResource key_converter}}"/>

                <CheckBox Content="Script"
                          IsHitTestVisible="False"
                          Focusable="False"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0 10 0 -5">
                    <Button Content="{icon:Lucide Kind=Pencil, Width=12, Height=12}"
                            Padding="6 6"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}"
                            Command="{Binding DataContext.EditShortcutCommand, RelativeSource={RelativeSource AncestorType={x:Type v:MainView}}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="{icon:Lucide Kind=Play, Width=12, Height=12}"
                            Padding="6 6"
                            Margin="20 0 0 0"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
