<UserControl x:Class="MacropadConfigurator.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:MacropadConfigurator.Views"
             xmlns:vm="clr-namespace:MacropadConfigurator.ViewModels" 
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">
    <StackPanel>
        <TextBlock Text="Layer: Shortcuts" />
        <ItemsControl>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <Border CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                    Margin="10"
                    Padding="10 10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0"
                                      ShadowDepth="5"
                                      Direction="-45"
                                      Color="{DynamicResource MahApps.Colors.ThemeForeground}"
                                      Opacity="0.4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Shortcut 1" FontWeight="Bold"/>
                    <TextBlock Text="Key: F13" />
                    <TextBlock Text="Mods: None" />
                    <CheckBox Content="Script"
                              IsHitTestVisible="False"
                              Focusable="False"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0 10 0 -5">
                        <Button Content="{icon:Lucide Kind=Pencil, Width=12, Height=12}"
                                Padding="6 6"
                                Style="{DynamicResource MahApps.Styles.Button.Circle}"/>
                        <Button Content="{icon:Lucide Kind=Play, Width=12, Height=12}"
                                Padding="6 6"
                                Margin="5 0 0 0"
                                Style="{DynamicResource MahApps.Styles.Button.Circle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                    Margin="10"
                    Padding="10 10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0"
                                      ShadowDepth="5"
                                      Direction="-45"
                                      Color="{DynamicResource MahApps.Colors.ThemeForeground}"
                                      Opacity="0.4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Shortcut 1" FontWeight="Bold"/>
                    <TextBlock Text="Key: F14" />
                    <TextBlock Text="Mods: Alt" />
                    <CheckBox Content="Script"/>

                    <StackPanel Orientation="Horizontal"
                    Margin="0 10 0 -5">
                        <Button Content="{icon:Lucide Kind=Pencil, Width=12, Height=12}"
                    Padding="6 6"
                    Style="{DynamicResource MahApps.Styles.Button.Circle}"/>
                        <Button Content="{icon:Lucide Kind=Play, Width=12, Height=12}"
                    Padding="6 6"
                    Margin="5 0 0 0"
                    Style="{DynamicResource MahApps.Styles.Button.Circle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                    Margin="10"
                    Padding="5">
                <StackPanel>
                    <TextBlock Text="Shortcut 3" FontWeight="Bold"/>
                    <TextBlock Text="Key: F15" />
                    <TextBlock Text="Mods: None" />
                </StackPanel>
            </Border>


            <TextBlock Text="Shortcut 4" />
            <TextBlock Text="Shortcut 5" />
            <TextBlock Text="Shortcut 6" />

            <TextBlock Text="Shortcut 7" />
            <TextBlock Text="Shortcut 8" />
            <TextBlock Text="Shortcut 9" />
        </ItemsControl>
    </StackPanel>
</UserControl>
