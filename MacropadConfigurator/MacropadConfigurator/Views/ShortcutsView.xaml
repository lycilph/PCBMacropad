<UserControl x:Class="MacropadConfigurator.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:MacropadConfigurator"
             xmlns:m="clr-namespace:MacropadConfigurator.Models"
             xmlns:vm="clr-namespace:MacropadConfigurator.ViewModels"
             xmlns:v="clr-namespace:MacropadConfigurator.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:ShortcutsViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="20 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Shortcuts"
                   FontSize="36"/>

        <Button Grid.Row="0"
                Grid.Column="1"
                Content="{icon:Lucide Kind=CirclePlus}"
                Style="{DynamicResource MahApps.Styles.Button.Circle}"
                HorizontalAlignment="Right"
                Width="36"
                Height="36"
                Command="{Binding CreateCommand}"/>

        <ScrollViewer Grid.Row="1"
                      Grid.ColumnSpan="2"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Shortcuts}"
                          Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:Shortcut">
                        <Border Margin="0 5"
                                Padding="5"
                                Background="{DynamicResource MahApps.Brushes.Accent4}"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="1"/>
                                    <ColumnDefinition SharedSizeGroup="2"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="4"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="5"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="6"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Margin="10 0" VerticalAlignment="Center" Text="{Binding Key, Converter={StaticResource key_converter}}"/>
                                <TextBlock Grid.Column="1" Margin="10 0" VerticalAlignment="Center" Text="{Binding Modifiers, Converter={StaticResource key_converter}, StringFormat=[{0}]}"/>
                                <TextBlock Grid.Column="2" Margin="10 0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Text="{Binding Name}"/>

                                <Button Grid.Column="3"
                                        Margin="5 0"
                                        Content="{icon:Lucide Kind=Trash2}"
                                        Command="{Binding DataContext.DeleteCommand, 
                                                          RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=v:ShortcutsView}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="4"
                                        Margin="5 0"
                                        Content="{icon:Lucide Kind=Settings}"
                                        Command="{Binding DataContext.EditCommand, 
                                                          RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=v:ShortcutsView}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="5"
                                        Margin="5 0"
                                        Content="{icon:Lucide Kind=Play}"
                                        Command="{Binding DataContext.ExecuteCommand, 
                                                          RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=v:ShortcutsView}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
